  "additionalGenericNodes": [
    "SquareWave",
    "TriangleWave",
    "IsFrontFace"
  ],
  "compatibilityNotes": [
    {
      "node": "UV",
      "note": "既存のUV0入力を維持。UnityのUV1〜3選択はメッシュ入力形式の拡張が必要なため未対応"
    },
    {
      "node": "ScreenPosition",
      "note": "既存のSV_POSITION相当のピクセル座標を維持。UnityのNormalized/Center/Tiled出力モードは含めない"
    },
    {
      "node": "NormalUnpack",
      "note": "既存の接空間法線デコード後にワールド空間へ変換する挙動を維持。接空間出力が必要な場合はTransformでWorldからTangentへ変換"
    },
    {
      "node": "Object",
      "note": "Rendererへ渡した境界を使用。GPU経路でローカル境界を保持しない場合は保守的な境界になる"
    },
    {
      "node": "Constant",
      "note": "Boolean/Color/Float/Integer/Vectorは既存の型付きConstantで共用。SliderはFloatパラメータで扱う"
    },
    {
      "node": "Matrix/Gradient",
      "note": "定数ノードと専用ノードで編集。MaterialParameterValueに行列とGradientを含めないため公開Materialパラメータにはしない"
    },
    {
      "node": "RoundedPolygon",
      "note": "正多角形の辺への符号付き距離に丸め半径を適用し、画面微分で輪郭を平滑化"
    },
    {
      "node": "ParallaxOcclusionMapping",
      "note": "高さマップ探索からUVとPixel Depth Offsetを出力。Surface出力へPixel Depth Offsetを直接書く機能は含めない"
    },
    {
      "node": "WhiteBalance",
      "note": "線形sRGBからXYZへ変換し、Bradford色順応でD65基準へ補正。色温度とTintの操作感を提供するがUnityのCAT02実装との数値一致は目的としない"
    },
    {
      "node": "GradientNoise",
      "note": "格子上の決定的な勾配ノイズ。整数ハッシュで勾配方向を選ぶためUnityのLegacy/Deterministicプリセットとのテクセル一致は含めない"
    },
    {
      "node": "Checkerboard/RoundedRectangle",
      "note": "チェッカー模様は画素幅で積分し、角丸四角形は符号付き距離で輪郭を平滑化。Unityの近似式との画素単位の一致は含めない"
    },
    {
      "node": "Parameter scope",
      "note": "未公開ParameterとGlobalの宣言にも既定値を渡す。Globalは現在も通常のMaterial定数領域を使い、実行中の全Materialへ値を配信する専用サービスは含めない"
    }
  ],
  "mathReferences": [
    {
      "title": "W3C CSS Color 4 - sRGB transfer functions and chromatic adaptation",
      "url": "https://www.w3.org/TR/css-color-4/"
    },
    {
      "title": "W3C Compositing and Blending Level 1 - separable blend operations",
      "url": "https://www.w3.org/TR/compositing-1/"
    },
    {
      "title": "Morten S. Mikkelsen - Bump Mapping Unparametrized Surfaces on the GPU",
      "url": "https://mmikk.github.io/papers3d/mm_sfgrad_bump.pdf"
    }
  ],
  "implementation": "Unity公式資料はノード機能と入出力の参照に使用。UnityのC#ソースファイルやライブラリは組み込まず、共有の数式評価器を実装"
}

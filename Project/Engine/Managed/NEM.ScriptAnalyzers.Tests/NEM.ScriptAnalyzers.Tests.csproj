<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NEM.ScriptAnalyzers の good/bad fixture を非 GUI で検証する console harness。
    Roslyn で fixture を in-memory compile し analyzer を走らせ、期待 diagnostic(NEMSC001-006)を assert する。
    intentional bad fixture を shipping GameScripts へ混ぜないため、fixture source はここに保持する。
    実行: dotnet run でこの console を起動する（exit 0 = pass）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <IsPackable>false</IsPackable>
    <!-- Develop 構成でも net10.0 single TFM。Optimize は不要 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- fixture が ScriptBehaviour/Debug/Entity を解決できるよう ScriptCore を参照する -->
    <ProjectReference Include="..\NEM.ScriptCore\NEM.ScriptCore.csproj" />
    <!-- analyzer 本体をクラスとして直接 new するため通常参照（Analyzer 参照ではない） -->
    <ProjectReference Include="..\NEM.ScriptAnalyzers\NEM.ScriptAnalyzers.csproj" />
  </ItemGroup>

</Project>

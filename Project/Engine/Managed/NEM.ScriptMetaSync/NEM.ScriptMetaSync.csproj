<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Editor が Edit モードで実行する script metadata 同期ツール。
    GameScripts の .cs を Roslyn(syntax) で解析し、concrete MonoBehaviour 型と serialized field を検出して
    各 .cs.meta の "scripts" ブロックへ Stable ID(UUID v4) を採番・維持する。
    通常開発では .cs へ [ScriptTypeID]/[SerializedFieldID] を手入力させないための機構。
    EditorSync: 不足を自動採番して .cs.meta を更新。ValidateOnly(CI): 不足を変更せず error 終了。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NEM.ScriptMetaSync</AssemblyName>
    <RootNamespace>NEM.ScriptMetaSync</RootNamespace>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <ProjectReference Include="..\NEM.ScriptCore\NEM.ScriptCore.csproj" />
    <Compile Include="..\Shared\ScriptSymbolRules.cs" Link="ScriptSymbolRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NEM.ScriptAnalyzers.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

<Window x:Class="NEMEngine.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource LauncherWindowStyle}" Title="NEMLauncher" Width="1100" Height="720" MinWidth="850" MinHeight="520" Loaded="OnLoaded">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><TextBlock Text="NEMEngine" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="LauncherVersion" Foreground="#999999" Margin="18,10,0,0"/></DockPanel>
    <TabControl x:Name="Tabs" Grid.Row="1" Background="#202020" BorderBrush="#404040">
      <TabItem Header="プロジェクト">
        <DockPanel Margin="12">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="新規作成" Click="CreateProject"/><Button Content="既存プロジェクトを追加" Click="AddProject"/>
          </WrapPanel>
          <DataGrid x:Name="Projects" MouseDoubleClick="ProjectDoubleClick">
            <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource LauncherListRowStyle}"><Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter><EventSetter Event="ContextMenuOpening" Handler="RowMenuOpening"/></Style></DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="プロジェクト" Width="*" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource LauncherListTitleStyle}"/>
                  <TextBlock Text="{Binding Descriptor}" Style="{StaticResource LauncherListDetailStyle}" Margin="0,3,0,0"/>
                </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="エンジン" Binding="{Binding EngineVersion}" Width="120" ElementStyle="{StaticResource LauncherListTextStyle}"/>
              <DataGridTemplateColumn Header="Git" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <Grid><TextBlock Text="未作成">
                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LauncherListDetailStyle}"><Style.Triggers><DataTrigger Binding="{Binding HasGitRepository}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Button Content="開く" Click="OpenProjectGit"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGitRepository}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="状態" Width="160" SortMemberPath="Status" CellTemplate="{StaticResource LauncherStatusTemplate}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="エンジン">
        <DockPanel Margin="12">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="エンジンバージョンの更新" Click="RefreshCatalog"/></WrapPanel>
          <DataGrid x:Name="Engines">
            <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource LauncherListRowStyle}"><Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter><EventSetter Event="ContextMenuOpening" Handler="RowMenuOpening"/></Style></DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="バージョン" Binding="{Binding Version}" Width="120" ElementStyle="{StaticResource LauncherListTitleStyle}"/>
              <DataGridTemplateColumn Header="状態" Width="160" SortMemberPath="Status" CellTemplate="{StaticResource LauncherStatusTemplate}"/>
              <DataGridTextColumn Header="ダウンロード" Binding="{Binding DownloadSize}" Width="140" ElementStyle="{StaticResource LauncherListTextStyle}"/>
              <DataGridTemplateColumn Header="内容" Width="*" SortMemberPath="Notes"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" MaxHeight="40" LineHeight="20" Style="{StaticResource LauncherListTextStyle}"/>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="アセット">
        <DockPanel Margin="12">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="アセット一覧を更新" Click="RefreshCatalog"/></WrapPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*" MinWidth="260"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="Assets" SelectionChanged="SelectAsset" Margin="0,0,16,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="アセット" Binding="{Binding Name}" Width="*" MinWidth="180" ElementStyle="{StaticResource LauncherListTitleStyle}"/>
                <DataGridTextColumn Header="版" Binding="{Binding Version}" Width="80" ElementStyle="{StaticResource LauncherListTextStyle}"/>
                <DataGridTextColumn Header="容量" Binding="{Binding DownloadSize}" Width="90" ElementStyle="{StaticResource LauncherListTextStyle}"/>
              </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,6,0,0">
                <TextBlock x:Name="AssetName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="AssetDescription" TextWrapping="Wrap" Margin="0,12,0,16"/>
                <TextBlock x:Name="AssetVersion" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="AssetEngine" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="AssetFileName" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Button x:Name="AssetDownload" Content="ダウンロード" Click="DownloadAsset" HorizontalAlignment="Left" IsEnabled="False"/>
                <Button x:Name="AssetOpenFolder" Content="保存先を開く" Click="OpenAssetFolder" HorizontalAlignment="Left" IsEnabled="False"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="設定">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock Text="GitHubアカウント"/>
          <DockPanel Margin="0,4,0,15">
            <Button x:Name="GitHubConnection" DockPanel.Dock="Right" Content="接続解除" Click="DisconnectGitHubAccount"/>
            <Button DockPanel.Dock="Right" Content="アカウントを追加" Click="AddGitHubAccount"/>
            <ComboBox x:Name="GitHubAccounts" ItemTemplate="{StaticResource GitHubAccountTemplate}" SelectedValuePath="Identity.ID" SelectionChanged="SelectGitHubAccount"/>
          </DockPanel>
          <TextBlock Text="エンジンのインストール先"/><DockPanel Margin="0,4,0,0"><Button DockPanel.Dock="Right" Content="選択" Click="SelectInstallRoot"/><TextBox x:Name="InstallRoot" IsReadOnly="True"/></DockPanel>
          <TextBlock Text="インストール先の変更は、これから導入するエンジンに適用されます。" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="4,4,0,15"/>
          <TextBlock Text="新規プロジェクトの既定の保存先"/><DockPanel Margin="0,4,0,15"><Button DockPanel.Dock="Right" Content="選択" Click="SelectProjectsRoot"/><TextBox x:Name="ProjectsRoot" IsReadOnly="True"/></DockPanel>
          <WrapPanel><Button Content="ランチャーを更新" Click="UpdateLauncher"/><Button Content="ログフォルダーを開く" Click="OpenLogs"/><Button Content="マニュアルを開く" Click="OpenManual"/></WrapPanel>
        </StackPanel></ScrollViewer>
        <Button Grid.Row="1" Content="バグ報告" Click="ReportBug" HorizontalAlignment="Right" Margin="4,16,4,4"/>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="Status" Text="準備完了" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="5" Margin="0,8,12,0" Maximum="100"/></StackPanel>
      <Button x:Name="CancelButton" Grid.Column="1" Content="キャンセル" IsEnabled="False" Click="CancelOperation"/>
    </Grid>
  </Grid>
</Window>

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- NEMTestsの依存ライブラリを再利用し、検証用の出力だけを隔離する -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NEMTests'">
    <OutDir>$(MSBuildThisFileDirectory)..\..\..\Generated\Output\$(Configuration)\GameBuildServiceProbe\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\..\Generated\Intermediate\GameBuildServiceProbe\$(Configuration)\</IntDir>
    <TargetName>GameBuildServiceProbe</TargetName>
    <TargetPath>$(OutDir)$(TargetName)$(TargetExt)</TargetPath>
    <TLogLocation>$(IntDir)$(TargetName).tlog\</TLogLocation>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'NEMTests'">
    <!-- 製品収集の検証へ無関係なテスト実装を持ち込まない -->
    <ClCompile Remove="@(ClCompile)" />
    <ClCompile Include="$(MSBuildThisFileDirectory)GameBuildServiceProbe.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\..\Engine\Editor\Build\GameBuild*.cpp" />
  </ItemGroup>
</Project>

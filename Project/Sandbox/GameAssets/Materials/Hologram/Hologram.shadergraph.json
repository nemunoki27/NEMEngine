            "customFunctionSource": "Inline",
            "functionBody": "void ScanLines(float3 Position, float Time, float Density, float Speed, out float Line) {\n    float phase = Position.y * max(0.0f, Density) - Time * Speed;\n    Line = smoothstep(0.65f, 0.98f, 0.5f + 0.5f * cos(6.2831853f * phase));\n}",

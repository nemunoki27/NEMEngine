        {
            "customFunctionSource": "Inline",
            "functionBody": "void HologramSurface(float Line, float Rim, float3 Tint, float Opacity, float RimIntensity,\n    out float3 Emission, out float Alpha) {\n    Emission = Tint * (0.34f + 1.25f * Line + Rim * max(0.0f, RimIntensity));\n    Alpha = saturate(Opacity * (0.38f + 0.62f * Line) + Rim * (1.0f - saturate(Opacity)));\n}",
            "functionFile": "",
            "functionFileAsset": "",
            "functionName": "HologramSurface",
            "groupID": "",
            "id": "7f5f2714ec9d1857",
            "inputPorts": [
                {
                    "id": "4f05cdf287b72f41",
                    "name": "Line",
                    "type": "Float",
                    "defaultValue": 0.0,
                    "hasDefault": true,
                    "sourceID": ""
                },
                {
                    "id": "d1d2106a439d4e1c",
                    "name": "Rim",
                    "type": "Float",
                    "defaultValue": 0.0,
                    "hasDefault": true,
                    "sourceID": ""
                },
                {

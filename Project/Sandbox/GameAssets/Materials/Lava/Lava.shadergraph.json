        {
            "customFunctionSource": "Inline",
            "functionBody": "float3 LavaCellOffset(float3 cell) {\n    float3 hash = frac(cell * float3(0.1031f, 0.1030f, 0.0973f));\n    hash += dot(hash, hash.yxz + 33.33f);\n    return frac((hash.xxy + hash.yxx) * hash.zyx);\n}\nvoid CrustCells(float3 Position, float Scale, float Width, out float Crack, out float Grain) {\n    float3 p = Position * max(abs(Scale), 0.001f);\n    p += 0.11f * sin(p.yzx * 3.2f + sin(p.zxy * 2.1f));\n    float3 cell = floor(p);\n    float3 local = frac(p);\n    float nearest = 8.0f, second = 8.0f;\n    [unroll] for (int z = -1; z <= 1; ++z) {\n        [unroll] for (int y = -1; y <= 1; ++y) {\n            [unroll] for (int x = -1; x <= 1; ++x) {\n                float3 offset = float3(x, y, z);\n                float3 delta = offset + 0.2f + 0.6f * LavaCellOffset(cell + offset) - local;\n                float d = dot(delta, delta);\n                second = min(second, max(nearest, d));\n                nearest = min(nearest, d);\n            }\n        }\n    }\n    float gap = sqrt(second) - sqrt(nearest);\n    float w = max(0.0001f, Width);\n    Crack = 1.0f - smoothstep(0.35f * w, w, gap);\n    Grain = 0.75f + 0.25f * cos(dot(p, float3(24.0f, 13.0f, -19.0f)) + 2.0f * sin(p.z * 17.0f));\n}",

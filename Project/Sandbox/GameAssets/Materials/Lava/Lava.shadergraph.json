            "functionBody": "void LavaFlow(float3 Position, float Time, float Speed, float Scale, out float Heat) {\n    float3 p = Position * max(abs(Scale), 0.001f);\n    float phase = dot(p, float3(2.7f, -3.2f, 1.5f)) + Time * Speed;\n    Heat = 0.55f + 0.45f * sin(phase + 1.7f * sin(p.z * 3.0f - Time * Speed * 0.42f));\n}",

        {
            "customFunctionSource": "Inline",
            "functionBody": "void MainLightLambert(float3 N, out float Light) {\n#if defined(NEM_LIGHTING_COMMON_HLSLI)\n    Light = 0.0f;\n    for (uint i = 0u; i < directionalCount; ++i) {\n        DirectionalLight light = gDirectionalLights[i];\n        if (light.intensity > 0.0f) {\n            Light = saturate(dot(N, normalize(-light.direction)));\n            break;\n        }\n    }\n#else\n    Light = saturate(dot(N, normalize(float3(-0.4f, 0.65f, 0.65f))));\n#endif\n}",

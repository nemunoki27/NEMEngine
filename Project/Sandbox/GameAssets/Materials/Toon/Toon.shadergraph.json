        {
            "customFunctionSource": "Inline",
            "functionBody": "void ToonBands(float Light, float3 Shadow, float3 Mid, float3 Lit, float Low, float High, float Softness, out float3 Color) {\n    float edge = max(0.0001f, abs(Softness));\n    float a = saturate(min(Low, High));\n    float b = saturate(max(Low, High));\n    Color = lerp(lerp(Shadow, Mid, smoothstep(a - edge, a + edge, Light)),\n        Lit, smoothstep(b - edge, b + edge, Light));\n}",
            "functionFile": "",
            "functionFileAsset": "",

set(CMAKE_POLICY_DEFAULT_CMP0091 NEW CACHE STRING "" FORCE)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>" CACHE STRING "" FORCE)

# Assetとして受け付ける形式だけを生成する
get_cmake_property(NEM_ASSIMP_CACHE_VARIABLES CACHE_VARIABLES)
foreach(NEM_ASSIMP_OPTION IN LISTS NEM_ASSIMP_CACHE_VARIABLES)
    if(NEM_ASSIMP_OPTION MATCHES "^ASSIMP_BUILD_.+_IMPORTER$")
        set(${NEM_ASSIMP_OPTION} OFF CACHE BOOL "" FORCE)
    endif()
endforeach()
set(ASSIMP_BUILD_ALL_IMPORTERS_BY_DEFAULT OFF CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_FBX_IMPORTER ON CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_GLTF_IMPORTER ON CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_OBJ_IMPORTER ON CACHE BOOL "" FORCE)

# OpenEXRCore 用の固定バージョンと Windows 静的リンク設定
set(root "${CMAKE_CURRENT_LIST_DIR}/../..")
set(source "${root}/Project/Externals/OpenEXRCore/config")
set(output "${root}/Generated/Externals/OpenEXRCore/include")
set(OPENEXR_VERSION 3.3.5)
set(OPENEXR_VERSION_MAJOR 3)
set(OPENEXR_VERSION_MINOR 3)
set(OPENEXR_VERSION_PATCH 5)
set(OPENEXR_PACKAGE_NAME OpenEXR)
set(OPENEXR_LIB_VERSION 3.3)
set(OPENEXR_NAMESPACE_CUSTOM 0)
set(OPENEXR_INTERNAL_IMF_NAMESPACE Imf_3_3)
set(OPENEXR_IMF_NAMESPACE Imf)
set(ILMTHREAD_THREADING_ENABLED 1)
set(ILMTHREAD_NAMESPACE_CUSTOM 0)
set(ILMTHREAD_INTERNAL_NAMESPACE IlmThread_3_3)
set(ILMTHREAD_NAMESPACE IlmThread)
set(IMATH_VERSION 3.1.12)
set(Imath_VERSION_MAJOR 3)
set(Imath_VERSION_MINOR 1)
set(Imath_VERSION_PATCH 12)
set(IMATH_LIB_VERSION 3.1)
set(IMATH_PACKAGE_NAME Imath)
set(IMATH_NAMESPACE_CUSTOM 0)
set(IMATH_INTERNAL_NAMESPACE Imath_3_1)
set(IMATH_NAMESPACE Imath)

foreach(header OpenEXRConfig OpenEXRConfigInternal IlmThreadConfig ImathConfig)
    configure_file("${source}/${header}.h.in" "${output}/${header}.h" @ONLY)
endforeach()

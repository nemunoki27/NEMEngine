<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NEMGameProjectRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</NEMGameProjectRoot>
    <NEMGameRoot>$([System.IO.Path]::GetFullPath('$(NEMGameProjectRoot)\..\..'))</NEMGameRoot>
    <NEMGameName>$([System.IO.Path]::GetFileName('$(NEMGameProjectRoot)'))</NEMGameName>
    <NEMGameManagedOutput>$(NEMGameRoot)\Generated\Output\$(Configuration)\$(NEMGameName)\Managed</NEMGameManagedOutput>
  </PropertyGroup>

  <!-- コンパイル対象と同じソースの保存IDを生成器へ渡す -->
  <Target Name="NEMCollectScriptMetadata" BeforeTargets="CoreCompile">
    <ItemGroup>
      <AdditionalFiles Remove="@(Compile->'%(FullPath).meta')" />
      <NEMScriptMetadataCandidate Remove="@(NEMScriptMetadataCandidate)" />
      <NEMScriptMetadataCandidate Include="@(Compile->'%(FullPath).meta')" />
      <AdditionalFiles Include="@(NEMScriptMetadataCandidate)" Condition="Exists('%(NEMScriptMetadataCandidate.Identity)')" />
    </ItemGroup>
  </Target>

  <Target Name="NEMDeployGameScripts" AfterTargets="Build"
          Condition="'$(NEMScriptStagingOutput)' == ''">
    <Error Condition="!Exists('$(TargetPath)')"
           Text="GameScripts.dllが見つかりません: $(TargetPath)" />
    <ItemGroup>
      <NEMGameScriptArtifact Include="$(TargetPath)" />
      <NEMGameScriptArtifact Include="$(TargetDir)$(TargetName).deps.json"
                             Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
      <NEMGameScriptArtifact Include="$(TargetDir)$(TargetName).pdb"
                             Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(NEMGameManagedOutput)" />
    <Copy SourceFiles="@(NEMGameScriptArtifact)"
          DestinationFolder="$(NEMGameManagedOutput)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
